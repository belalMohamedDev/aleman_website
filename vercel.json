{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://alemanapp.runasp.net/api/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "https://alemanapp.runasp.net/images/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://alemanapp.runasp.net/uploads/$1"
    },
    {
      "source": "/modules/recruitment/(.*)",
      "destination": "https://www.alemanfeed.com/modules/recruitment/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
